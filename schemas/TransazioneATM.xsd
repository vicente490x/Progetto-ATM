<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:simpleType name="TestoNonVuoto">
    <xs:restriction base="xs:token">
      <xs:minLength value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PINCinqueCifre">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{5}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ImportoPrelievo">
    <xs:restriction base="xs:decimal">
      <xs:minExclusive value="0"/>
      <xs:fractionDigits value="2"/>
      <xs:pattern value="[0-9]+(\.[0-9]{1,2})?"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="TransazioneATM">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Cliente">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Nome" type="TestoNonVuoto"/>
              <xs:element name="Cognome" type="TestoNonVuoto"/>
              <xs:element name="PIN" type="PINCinqueCifre"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="DettagliPrelievo">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Importo" type="ImportoPrelievo"/>
              <xs:element name="DataOra" type="xs:dateTime"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
