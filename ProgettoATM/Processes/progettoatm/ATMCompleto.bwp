            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes" eventTimeout="60" name="FilePoller" tibex:xpdlId="b76e2534-4efd-4643-999a-f69823f15135" variable="FilePoller">
                    <bpws:sources><bpws:source linkName="FileToParse"><tibex:DesignExpression><tibex:expression expression="string-length($FilePoller/fileContent/textContent) &gt; 0 and (matches($FilePoller/fileInfo/fileName, '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\.xml$'))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/></tibex:DesignExpression><bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0">string-length($FilePoller/fileContent/textContent) &gt; 0 and (matches($FilePoller/fileInfo/fileName, '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\.xml$'))</bpws:transitionCondition></bpws:source><bpws:source linkName="FileToNomeKO"><tibex:DesignExpression><tibex:expression expression="string-length($FilePoller/fileContent/textContent) &gt; 0 and (not(matches($FilePoller/fileInfo/fileName, '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\.xml$')))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/></tibex:DesignExpression><bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0">string-length($FilePoller/fileContent/textContent) &gt; 0 and (not(matches($FilePoller/fileInfo/fileName, '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\.xml$')))</bpws:transitionCondition></bpws:source></bpws:sources><tibex:eventSource>
                        <bwext:BWActivity xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig" xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext" xmlns:file="http://ns.tibco.com/bw/palette/file" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" activityTypeID="bw.file.poller">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/file#//FilePoller"/>
                                    <value contentAs="text" createEvent="true" encodingUsed="UTF-8" fileName="C:\Users\utente\Desktop\Progetto ATM\input\*.xml" includeCurrent="true" mode="files-and-directories" pollInterval="5" sortby="File Name" sortorder="descending" xsi:type="file:FilePoller" modifyEvent="true"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="ParseXml-input" name="ParseXml" outputVariable="ParseXml" tibex:xpdlId="3f3d5918-3553-4172-86c4-57d237c67736">
                    <bpws:targets><bpws:target linkName="FileToParse"/></bpws:targets><bpws:sources><bpws:source linkName="ParseToConcludi"/><bpws:source linkName="ParseToError" tibex:faultDetailsVar="_error_ParseXml" tibex:faultNameVar="FaultName"><tibex:DesignExpression><tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/></tibex:DesignExpression><bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0">##error##</bpws:transitionCondition></bpws:source></bpws:sources><tibex:inputBindings>
                        <tibex:inputBinding expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?&gt;&#10;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/parsexml&quot; version=&quot;2.0&quot;&gt;&lt;xsl:param name=&quot;FilePoller&quot;/&gt;&lt;xsl:template name=&quot;ParseXml-input&quot; match=&quot;/&quot;&gt;&lt;tns1:xmlString&gt;&lt;xsl:value-of select=&quot;$FilePoller/fileContent/textContent&quot;/&gt;&lt;/tns1:xmlString&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig" xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext" xmlns:palettexml="http://ns.tibco.com/bw/palette/xmlpalette" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" activityTypeID="bw.xml.parsexml" version="6.0.0.20121128">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/xmlpalette#//ParseXml"/>
                                    <value inputStyle="text" outputElementQName="TransazioneATM" validateOutput="true" xsi:type="palettexml:ParseXml"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="ConcludiPrelievo-input" name="ConcludiPrelievo" outputVariable="ConcludiPrelievo" tibex:xpdlId="c2046539-b96c-427d-a1a9-f9ee15bedeaf">
                    <bpws:targets><bpws:target linkName="ParseToConcludi"/></bpws:targets><bpws:sources><bpws:source linkName="ConcludiToOK"><tibex:DesignExpression><tibex:expression expression="$ConcludiPrelievo/Record[1]/esito = 'OK' or $ConcludiPrelievo/Record[1]/esito = 'GIA_ELABORATA'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/></tibex:DesignExpression><bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0">$ConcludiPrelievo/Record[1]/esito = 'OK' or $ConcludiPrelievo/Record[1]/esito = 'GIA_ELABORATA'</bpws:transitionCondition></bpws:source><bpws:source linkName="ConcludiToRifiuto"><tibex:DesignExpression><tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/></tibex:DesignExpression><bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0">##otherwise##</bpws:transitionCondition></bpws:source><bpws:source linkName="ConcludiToErrore" tibex:faultDetailsVar="_error_ConcludiPrelievo" tibex:faultNameVar="FaultName"><tibex:DesignExpression><tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/></tibex:DesignExpression><bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0">##error##</bpws:transitionCondition></bpws:source></bpws:sources><tibex:inputBindings><tibex:inputBinding expression="&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+c2046539-b96c-427d-a1a9-f9ee15bedeaf+input&quot; xmlns:xs=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;&gt;&lt;xsl:param name=&quot;FilePoller&quot;/&gt;&lt;xsl:param name=&quot;ParseXml&quot;/&gt;&lt;xsl:template name=&quot;ConcludiPrelievo-input&quot; match=&quot;/&quot;&gt;&lt;tns:jdbcQueryActivityInput&gt;&lt;p_id&gt;&lt;xsl:value-of select=&quot;substring-before($FilePoller/fileInfo/fileName, '.xml')&quot;/&gt;&lt;/p_id&gt;&lt;p_nome&gt;&lt;xsl:value-of select=&quot;$ParseXml/Cliente/Nome&quot;/&gt;&lt;/p_nome&gt;&lt;p_cognome&gt;&lt;xsl:value-of select=&quot;$ParseXml/Cliente/Cognome&quot;/&gt;&lt;/p_cognome&gt;&lt;p_pin&gt;&lt;xsl:value-of select=&quot;$ParseXml/Cliente/PIN&quot;/&gt;&lt;/p_pin&gt;&lt;p_importo&gt;&lt;xsl:value-of select=&quot;xs:long(round($ParseXml/DettagliPrelievo/Importo * 100))&quot;/&gt;&lt;/p_importo&gt;&lt;/tns:jdbcQueryActivityInput&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/></tibex:inputBindings><tibex:config>
                        <bwext:BWActivity xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig" xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext" xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" activityTypeID="bw.jdbc.JDBCQuery">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="1" sharedResourceProperty="jdbcProperty" sqlStatement="WITH richiesta AS (&#10; SELECT CAST(? AS UUID) AS id, CAST(? AS TEXT) AS nome,&#10;        CAST(? AS TEXT) AS cognome, CAST(? AS TEXT) AS pin, CAST(? AS BIGINT) AS importo&#10;), cliente AS MATERIALIZED (&#10; SELECT c.id, c.saldo_centesimi FROM public.clienti c, richiesta r&#10; WHERE lower(btrim(c.nome)) = lower(btrim(r.nome))&#10; AND lower(btrim(c.cognome)) = lower(btrim(r.cognome)) AND c.pin = r.pin&#10; FOR UPDATE OF c&#10;), precedente AS MATERIALIZED (&#10; SELECT t.* FROM public.transazioni t, richiesta r WHERE t.id_richiesta = r.id&#10;), registrata AS (&#10; INSERT INTO public.transazioni&#10; (id_richiesta, cliente_id, importo_centesimi, stato, messaggio, conclusa_il)&#10; SELECT r.id, c.id, r.importo,&#10; CASE WHEN c.saldo_centesimi &gt;= r.importo THEN 'ESEGUITA' ELSE 'RIFIUTATA' END,&#10; CASE WHEN c.saldo_centesimi &gt;= r.importo THEN 'Prelievo eseguito da TIBCO' ELSE 'Saldo insufficiente' END,&#10; CURRENT_TIMESTAMP&#10; FROM richiesta r CROSS JOIN cliente c&#10; WHERE r.importo &gt; 0 AND NOT EXISTS (SELECT 1 FROM precedente)&#10; AND NOT EXISTS (SELECT 1 FROM public.transazioni t WHERE t.cliente_id=c.id AND t.stato='PRENOTATA')&#10; ON CONFLICT (id_richiesta) DO NOTHING&#10; RETURNING cliente_id, importo_centesimi, stato&#10;), addebito AS (&#10; UPDATE public.clienti c SET saldo_centesimi = c.saldo_centesimi - t.importo_centesimi&#10; FROM registrata t WHERE c.id=t.cliente_id AND t.stato='ESEGUITA'&#10; RETURNING c.saldo_centesimi&#10;)&#10;SELECT CASE&#10; WHEN r.importo &lt;= 0 THEN 'DATI_NON_VALIDI'&#10; WHEN NOT EXISTS (SELECT 1 FROM cliente) THEN 'CLIENTE_NON_VALIDO'&#10; WHEN EXISTS (SELECT 1 FROM precedente t, cliente c WHERE t.cliente_id&lt;&gt;c.id OR t.importo_centesimi&lt;&gt;r.importo) THEN 'CONFLITTO_ID'&#10; WHEN EXISTS (SELECT 1 FROM precedente WHERE stato='ESEGUITA') THEN 'GIA_ELABORATA'&#10; WHEN EXISTS (SELECT 1 FROM precedente WHERE stato='RIFIUTATA') THEN 'RIFIUTATA'&#10; WHEN EXISTS (SELECT 1 FROM addebito) THEN 'OK'&#10; WHEN EXISTS (SELECT 1 FROM registrata WHERE stato='RIFIUTATA') THEN 'SALDO_INSUFFICIENTE'&#10; ELSE 'RICHIESTA_DA_VERIFICARE'&#10; END AS esito,&#10; COALESCE((SELECT saldo_centesimi FROM addebito),(SELECT saldo_centesimi FROM cliente)) AS saldo_centesimi&#10;FROM richiesta r" timeout="30" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters ParameterName="p_id" DataType="12" DataTypeDisplayValue="VARCHAR"/><PreparedParameters ParameterName="p_nome" DataType="12" DataTypeDisplayValue="VARCHAR"/><PreparedParameters ParameterName="p_cognome" DataType="12" DataTypeDisplayValue="VARCHAR"/><PreparedParameters ParameterName="p_pin" DataType="12" DataTypeDisplayValue="VARCHAR"/><PreparedParameters ParameterName="p_importo" DataType="-5" DataTypeDisplayValue="BIGINT"/><columnMetadata columnIndex="1" columnName="esito" dataType="12" typeName="VARCHAR" status="OptionalElement"/><columnMetadata columnIndex="2" columnName="saldo_centesimi" dataType="-5" typeName="BIGINT" status="OptionalElement"/></value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="PrelievoRifiutato-input" name="PrelievoRifiutato" tibex:xpdlId="fe283b54-26c0-493a-8167-187e26d22a63">
                    <bpws:targets><bpws:target linkName="ConcludiToRifiuto"/></bpws:targets><bpws:sources><bpws:source linkName="RifiutoToError"/></bpws:sources><tibex:inputBindings><tibex:inputBinding expression="&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:xs=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;&gt;&lt;xsl:param name=&quot;ConcludiPrelievo&quot;/&gt;&lt;xsl:template name=&quot;PrelievoRifiutato-input&quot; match=&quot;/&quot;&gt;&lt;tns:ActivityInput&gt;&lt;message&gt;&lt;xsl:value-of select=&quot;concat('Prelievo non eseguito: ', $ConcludiPrelievo/Record[1]/esito)&quot;/&gt;&lt;/message&gt;&lt;/tns:ActivityInput&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/></tibex:inputBindings><tibex:config>
                        <bwext:BWActivity xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig" xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext" xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" activityTypeID="bw.generalactivities.log" version="6.0.0.001">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value controlBy="Application" role="Info" suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="PrelievoOK-input" name="PrelievoOK" tibex:xpdlId="3e496487-ca57-4b8b-b1f7-49f5abb46e4d">
