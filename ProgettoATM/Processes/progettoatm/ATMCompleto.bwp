        <bpws:extensionActivity><tibex:activityExtension name="SpostaProcessed" inputVariable="SpostaProcessed-input" outputVariable="SpostaProcessed" tibex:xpdlId="2345869b-6ee2-4b19-aca1-f575b3be65c1"><bpws:targets><bpws:target linkName="OKToProcessed"/></bpws:targets><tibex:inputBindings><tibex:inputBinding expression="&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; version=&quot;2.0&quot;&gt;&lt;xsl:param name=&quot;FilePoller&quot;/&gt;&lt;xsl:template name=&quot;SpostaProcessed-input&quot; match=&quot;/&quot;&gt;&lt;tns:RenameActivityInputClass&gt;&lt;fromFileName&gt;&lt;xsl:value-of select=&quot;$FilePoller/fileInfo/fullName&quot;/&gt;&lt;/fromFileName&gt;&lt;toFileName&gt;&lt;xsl:value-of select=&quot;concat(replace(translate($FilePoller/fileInfo/fullName, '\', '/'), '/input/[^/]+$', ''), '/processed/', $FilePoller/fileInfo/fileName)&quot;/&gt;&lt;/toFileName&gt;&lt;/tns:RenameActivityInputClass&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/></tibex:inputBindings><tibex:config><ns2:BWActivity xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig" xmlns:file="http://ns.tibco.com/bw/palette/file" xmlns:ns2="http://tns.tibco.com/bw/model/core/bwext" activityTypeID="bw.file.rename"><activityConfig><properties xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="config" xsi:type="activityconfig:EMFProperty"><type href="http://ns.tibco.com/bw/palette/file#//RenameFile"/><value overwrite="true" createDestinationDirectories="false" xsi:type="file:RenameFile"/></properties></activityConfig></ns2:BWActivity></tibex:config></tibex:activityExtension></bpws:extensionActivity><bpws:extensionActivity><tibex:activityExtension name="SpostaRifiutato" inputVariable="SpostaRifiutato-input" outputVariable="SpostaRifiutato" tibex:xpdlId="a3e4db51-dafd-4453-af5a-23da34d554fa"><bpws:targets><bp